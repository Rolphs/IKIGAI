{#
  Pill de respuesta para el chat del Coach.
  Simula la burbuja del usuario con feedback de guardado.
#}
<div class="intro-answer-pill chat-bubble-user group relative"
    data-item-id="{{ item.id }}">
  <div class="flex flex-col gap-1">
    <span class="text-sm pr-4">{{ item.item }}</span>

    <div class="flex flex-wrap gap-1 text-[9px] opacity-80">
      {% if item.tag_amo %}<span class="bg-white/20 px-1.5 py-0.5 rounded">❤️ Amo</span>{% endif %}
      {% if item.tag_bueno %}<span class="bg-white/20 px-1.5 py-0.5 rounded">💪 Bueno</span>{% endif %}
      {% if item.tag_mundo %}<span class="bg-white/20 px-1.5 py-0.5 rounded">🌍 Mundo</span>{% endif %}
      {% if item.tag_pago %}<span class="bg-white/20 px-1.5 py-0.5 rounded">💵 Pago</span>{% endif %}
      
      {% if not (item.tag_amo or item.tag_bueno or item.tag_mundo or item.tag_pago) %}
        <span class="bg-white/20 px-1.5 py-0.5 rounded italic opacity-60">Sombra</span>
      {% endif %}
    </div>
  </div>

  <button type="button"
          hx-delete="{{ ikigai_url }}/inventario/item/{{ item.id }}"
          hx-target="closest .intro-answer-pill"
          hx-swap="outerHTML"
          hx-confirm="¿Eliminar esta reflexión?"
          class="absolute -right-2 -top-2 w-5 h-5 bg-danger-100 text-white rounded-full 
                 opacity-0 group-hover:opacity-100 transition-opacity duration-200
                 flex items-center justify-center text-[10px] shadow-sm
                 hover:scale-110 active:scale-90 focus:outline-none"
          title="Borrar respuesta">
    ✕
  </button>
</div>
