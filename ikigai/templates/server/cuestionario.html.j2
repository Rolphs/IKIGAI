{% extends "_base.html.j2" %}
{% set active_section = 'intro' %}

{% block title %}Coach · ikigai 🌷{% endblock %}

{% block extra_head %}
<style>
  .chat-bubble-bot {
      @apply bg-white border border-ink-50 rounded-2xl rounded-tl-none p-4 shadow-sm max-w-[85%];
      animation: bubbleIn 0.3s ease-out forwards;
  }
  .chat-bubble-user {
      @apply bg-brand-100 text-white rounded-2xl rounded-br-none p-3 shadow-md max-w-[80%] self-end;
      animation: bubbleIn 0.2s ease-out forwards;
  }
  @keyframes bubbleIn {
    from { opacity: 0; transform: translateY(10px) scale(0.95); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  .typing-dot {
    animation: typing 1.4s infinite;
  }
  @keyframes typing {
    0%, 100% { opacity: 0.2; }
    50% { opacity: 1; }
  }
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>
{% endblock %}

{% block page_title %}Coach · Introspección{% endblock %}

{% block header_right %}
<span class="hidden sm:inline">{{ master_title }}</span>
{% endblock %}

{% block main %}
<main class="flex-1 max-w-3xl mx-auto w-full flex flex-col relative overflow-hidden bg-white sm:my-4 sm:rounded-3xl sm:shadow-xl sm:border sm:border-ink-50">

    <!-- Chat Area -->
    <div id="chat-messages" class="flex-1 overflow-y-auto p-4 md:p-6 space-y-6 flex flex-col no-scrollbar">
        <!-- Intro -->
        <div class="chat-bubble-bot">
            <p class="text-sm leading-relaxed text-ink-120">
                Bienvenido a este espacio de escucha. 🌷 <br>
                A través de este diálogo, daremos forma a tu inventario personal. Responde con libertad, dejando que las ideas fluyan sin juicio.
            </p>
        </div>

        {# Cada pregunta se renderiza con su PROPIO form inline (mejora:
           campo de reflexion por pregunta). Sin cursor global ni form
           compartido: el bloque trae pregunta + pills + su input + strip. #}
        {% for section in sections %}
          {% include "_cuestionario_section_block.html.j2" with context %}
        {% endfor %}
    </div>

    <!-- Footer: navegacion al visualizador -->
    <div class="p-4 border-t border-ink-50 bg-ink-5/50 flex justify-end">
        <a href="{{ ikigai_url }}/visualizador"
           class="text-sm font-bold text-success-100 hover:underline uppercase tracking-wider">
            Ver mi Mapa de Propósito 🌷
        </a>
    </div>
</main>
{% endblock %}

{% block body_scripts %}
<script src="/static/viz/viz_helpers.js"></script>
<script>
    const IKIGAI_URL = {{ ikigai_url|tojson }};

    // Tras agregar una reflexion: limpiar el textarea, devolver el foco
    // (para encadenar varias reflexiones a la misma pregunta) y refrescar
    // el strip de resultado real de ESA seccion (paralela pregunta↔resultado).
    function onSectionAnswer(form, evt) {
        const xhr = evt.detail && evt.detail.xhr;
        if (xhr && xhr.status >= 400) return;  // error: dejar el texto para reintentar
        const tx = form.querySelector('textarea[name="item_text"]');
        if (tx) { tx.value = ''; tx.style.height = 'auto'; tx.focus(); }
        if (window.showToast) showToast('Reflexión guardada', 'success');
        refreshStrip(form.dataset.sectionCsv);
    }

    async function refreshStrip(csvValue) {
        // Re-fetch del strip de resultado real para mantener la paralela
        // pregunta↔resultado siempre cuadrada después de cada submit/delete.
        if (!csvValue) return;
        try {
            const resp = await fetch(`${IKIGAI_URL}/introspeccion/section/${encodeURIComponent(csvValue)}/strip`);
            if (!resp.ok) return;
            const wrap = document.getElementById(`strip-${csvValue}`);
            if (wrap) wrap.innerHTML = await resp.text();
        } catch (_) { /* silencio: el strip se refrescará al próximo evento */ }
    }

    // Si se elimina un pill (X), refrescar el strip de su seccion para
    // mantener la barra de distribucion sincronizada con los pills.
    document.body.addEventListener('htmx:afterRequest', (evt) => {
        const xhr = evt.detail.xhr;
        if (!xhr || xhr.status !== 200) return;
        const target = evt.detail.target;
        if (!target || !target.classList.contains('intro-answer-pill')) return;
        const block = evt.detail.elt && evt.detail.elt.closest('.cuestionario-section-block');
        if (block && block.dataset.sectionCsv) refreshStrip(block.dataset.sectionCsv);
    });
</script>
{% endblock %}
